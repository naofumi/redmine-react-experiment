hideModal();
<% select = content_tag('select', content_tag('option') + version_options_for_select(@project.shared_versions.open, @version), :id => 'issue_fixed_version_id', :name => 'issue[fixed_version_id]') %>
var issueField = document.getElementById('issue_fixed_version_id');
if (issueField && issueField.hasAttribute('data-react-issue-field')) {
  var options = document.createElement('template');
  options.innerHTML = '<%= escape_javascript(select) %>';
  issueField.dispatchEvent(new CustomEvent('redmine:issue-field-options', {
    detail: { optionsHtml: options.content.firstElementChild.innerHTML, value: '<%= @version.id %>' }
  }));
} else {
  $('#issue_fixed_version_id').replaceWith('<%= escape_javascript(select) %>');
}
